<?xml version="1.0" encoding="utf-8"?>
<!-- Feed top bar: post, my activity, staff dashboard (clerk and faculty only), overflow with Log out. -->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/action_post_item"
        android:icon="@drawable/ic_add"
        android:title="@string/cd_post_item"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_my_activity"
        android:icon="@drawable/ic_history"
        android:title="@string/cd_my_activity"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_staff_dashboard"
        android:icon="@drawable/ic_inbox"
        android:title="@string/cd_staff_dashboard"
        android:visible="false"
        app:showAsAction="always" />
    <item
        android:id="@+id/action_log_out"
        android:title="@string/action_log_out"
        app:showAsAction="never" />
</menu>
