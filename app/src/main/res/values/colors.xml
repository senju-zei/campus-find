<?xml version="1.0" encoding="utf-8"?>
<!-- Light palette (section 7). values-night/colors.xml must define the same names. -->
<resources>
    <color name="background">#F6F4EE</color>
    <color name="surface">#FFFFFF</color>
    <color name="border">#E2DED3</color>
    <color name="text">#1F1E1A</color>
    <color name="text_muted">#6C685E</color>
    <color name="accent">#2E5E4E</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="accent_tint">#E4EDE8</color>

    <!-- Chips: background / text. Type chip uses accent_tint / accent. -->
    <color name="chip_neutral_bg">#E9E8E4</color>
    <color name="chip_neutral_text">#55534D</color>
    <color name="chip_pending_bg">#EFE6D2</color>
    <color name="chip_pending_text">#6F5316</color>
    <color name="chip_success_bg">#E1EBDD</color>
    <color name="chip_success_text">#3B5A33</color>
    <color name="chip_error_bg">#F1DEDA</color>
    <color name="chip_error_text">#7A2E26</color>

    <color name="transparent">#00000000</color>

    <!-- Launcher icon and splash icon circle. -->
    <color name="launcher_background">@color/accent</color>
    <color name="launcher_glyph">@color/on_accent</color>

    <!-- Item colors: tint for category icons and color dots. "white" and "black" are
         shifted so they stay visible on the light and dark backgrounds. -->
    <color name="item_black">#2B2B2B</color>
    <color name="item_white">#B9B6AC</color>
    <color name="item_gray">#7E7C76</color>
    <color name="item_blue">#3B6FB6</color>
    <color name="item_red">#B8433A</color>
    <color name="item_green">#3E7D4A</color>
    <color name="item_yellow">#B8871A</color>
    <color name="item_brown">#7A5230</color>
    <color name="item_pink">#C46A8E</color>
</resources>
