<?xml version="1.0" encoding="utf-8"?>
<!-- My activity: Posts and Claims tabs. No filled button on this screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Profile header. The name cannot be changed (rules). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/screen_margin">

        <!-- Profile picture, or initials when there is none. Tap to change it. -->
        <FrameLayout
            android:id="@+id/avatar"
            android:layout_width="@dimen/avatar_size"
            android:layout_height="@dimen/avatar_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/cd_change_photo"
            android:focusable="true">

            <TextView
                android:id="@+id/initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_initials"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.CampusFind.Title"
                android:textColor="@color/accent" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.CampusFind.Circle" />

            <ImageView
                android:layout_width="@dimen/avatar_badge_size"
                android:layout_height="@dimen/avatar_badge_size"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_avatar_badge"
                android:importantForAccessibility="no"
                android:padding="@dimen/space_1"
                android:src="@drawable/ic_photo_camera" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/photoProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="@color/accent"
                app:indicatorSize="@dimen/icon_size" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_3"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CampusFind.Large.Medium" />

            <TextView
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CampusFind.Small" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/role"
                    style="@style/Widget.CampusFind.StatusChip"
                    android:background="@drawable/bg_chip_type"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/counts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.CampusFind.Small" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logOutButton"
            style="@style/Widget.CampusFind.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_log_out" />
    </LinearLayout>

    <!-- Students: found items still OPEN that have not reached the CS Office. Tap opens Posts. -->
    <TextView
        android:id="@+id/turnInReminder"
        style="@style/Widget.CampusFind.Row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginEnd="@dimen/screen_margin"
        android:layout_marginBottom="@dimen/space_3"
        android:background="@drawable/bg_chip_pending"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.CampusFind.Body"
        android:textColor="@color/chip_pending_text"
        android:visibility="gone" />

    <View style="@style/Widget.CampusFind.Divider" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- Staff only, instead of the tabs. -->
    <TextView
        android:id="@+id/historyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="@dimen/touch_target"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="@dimen/space_3"
        android:text="@string/hint_history"
        android:textAppearance="@style/TextAppearance.CampusFind.Body.Medium"
        android:visibility="gone" />

    <View style="@style/Widget.CampusFind.Divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/screen_margin"
                android:paddingTop="@dimen/space_4"
                android:paddingEnd="@dimen/screen_margin"
                android:paddingBottom="@dimen/space_4" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_6"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/logo_size_small"
                android:layout_height="@dimen/logo_size_small"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/emptyAction"
                style="@style/Widget.CampusFind.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_3" />
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_6"
            android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
