<?xml version="1.0" encoding="utf-8"?>
<!-- Item detail. The hidden detail is never shown here. "Claim item" (step 6) is the only
     filled button; "Close report" is outlined. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/picture"
                android:layout_width="@dimen/badge_size_detail"
                android:layout_height="@dimen/badge_size_detail"
                android:background="@color/accent_tint"
                android:contentDescription="@string/cd_item_badge"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.CampusFind.Control" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_4"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CampusFind.Title" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/typeChip"
                        style="@style/Widget.CampusFind.StatusChip" />

                    <TextView
                        android:id="@+id/statusChip"
                        style="@style/Widget.CampusFind.StatusChip"
                        android:layout_marginStart="@dimen/space_2" />
                </LinearLayout>

                <TextView
                    android:id="@+id/postedBy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:textAppearance="@style/TextAppearance.CampusFind.Small" />
            </LinearLayout>
        </LinearLayout>

        <View
            style="@style/Widget.CampusFind.Divider"
            android:layout_marginTop="@dimen/space_4" />

        <TextView
            style="@style/Widget.CampusFind.FieldLabel"
            android:text="@string/field_category" />

        <TextView
            android:id="@+id/category"
            style="@style/Widget.CampusFind.FieldValue" />

        <TextView
            style="@style/Widget.CampusFind.FieldLabel"
            android:text="@string/field_location" />

        <TextView
            android:id="@+id/location"
            style="@style/Widget.CampusFind.FieldValue" />

        <TextView
            style="@style/Widget.CampusFind.FieldLabel"
            android:text="@string/field_public_description" />

        <TextView
            android:id="@+id/description"
            style="@style/Widget.CampusFind.FieldValue" />

        <LinearLayout
            android:id="@+id/colorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.CampusFind.FieldLabel"
                android:text="@string/field_color" />

            <TextView
                android:id="@+id/color"
                style="@style/Widget.CampusFind.FieldValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/brandRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.CampusFind.FieldLabel"
                android:text="@string/field_brand" />

            <TextView
                android:id="@+id/brand"
                style="@style/Widget.CampusFind.FieldValue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bookFields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Widget.CampusFind.FieldLabel"
                android:text="@string/field_book_authors" />

            <TextView
                android:id="@+id/authors"
                style="@style/Widget.CampusFind.FieldValue" />

            <TextView
                style="@style/Widget.CampusFind.FieldLabel"
                android:text="@string/field_isbn" />

            <TextView
                android:id="@+id/isbn"
                style="@style/Widget.CampusFind.FieldValue" />
        </LinearLayout>

        <!-- Turned-in items: the owner can look at the real item before claiming. -->
        <TextView
            android:id="@+id/seeAtOffice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:text="@string/label_see_at_office"
            android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted"
            android:visibility="gone" />

        <!-- The signed-in student's own claim on this item, if any. -->
        <LinearLayout
            android:id="@+id/claimBox"
            style="@style/Widget.CampusFind.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:foreground="@null"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_your_claim"
                    android:textAppearance="@style/TextAppearance.CampusFind.Body.Medium" />

                <TextView
                    android:id="@+id/claimStatusChip"
                    style="@style/Widget.CampusFind.StatusChip" />
            </LinearLayout>

            <TextView
                android:id="@+id/claimNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:textAppearance="@style/TextAppearance.CampusFind.Body" />

            <TextView
                android:id="@+id/claimReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted"
                android:visibility="gone" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_6" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/claimButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_claim_item"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/markTurnedInButton"
            style="@style/Widget.CampusFind.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/action_mark_turned_in"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeReportButton"
            style="@style/Widget.CampusFind.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:text="@string/action_close_report"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/changeStatusButton"
            style="@style/Widget.CampusFind.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_1"
            android:text="@string/action_change_status"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
