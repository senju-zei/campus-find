<?xml version="1.0" encoding="utf-8"?>
<!-- Staff dashboard: Claims (oldest first) and To turn in. No filled button here; Approve is on Review claim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <View style="@style/Widget.CampusFind.Divider" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="@dimen/space_3"
        android:paddingEnd="@dimen/screen_margin"
        android:text="@string/hint_tap_review"
        android:textAppearance="@style/TextAppearance.CampusFind.Small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteOldButton"
        style="@style/Widget.CampusFind.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_margin"
        android:layout_marginTop="@dimen/space_2"
        android:layout_marginEnd="@dimen/screen_margin"
        android:text="@string/action_delete_old"
        android:textColor="@color/chip_error_text"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingTop="@dimen/space_4"
            android:paddingEnd="@dimen/screen_margin"
            android:paddingBottom="@dimen/space_4" />

        <LinearLayout
            android:id="@+id/empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_6"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/logo_size_small"
                android:layout_height="@dimen/logo_size_small"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_logo" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted" />

        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="@dimen/space_6"
            android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted"
            android:visibility="gone" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
