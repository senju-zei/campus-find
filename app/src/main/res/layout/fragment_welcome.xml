<?xml version="1.0" encoding="utf-8"?>
<!-- Landing page for signed-out users. No form here: Log in and Create account open their own screens. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_6"
        android:paddingTop="@dimen/space_8"
        android:paddingEnd="@dimen/space_6"
        android:paddingBottom="@dimen/space_6">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:contentDescription="@string/cd_logo"
            android:src="@drawable/ic_logo_animated" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_6"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.CampusFind.Title" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_2"
            android:gravity="center"
            android:text="@string/welcome_tagline"
            android:textAppearance="@style/TextAppearance.CampusFind.Large" />

        <TextView
            android:id="@+id/body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:maxWidth="@dimen/welcome_text_max_width"
            android:text="@string/welcome_body"
            android:textAppearance="@style/TextAppearance.CampusFind.Body.Muted" />

        <TextView
            android:id="@+id/pilot"
            style="@style/Widget.CampusFind.StatusChip"
            android:layout_marginTop="@dimen/space_4"
            android:background="@drawable/bg_chip_type"
            android:text="@string/welcome_pilot"
            android:textColor="@color/accent" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_8" />

        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logInButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/action_log_in" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/createAccountButton"
                style="@style/Widget.CampusFind.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/action_create_account" />

            <TextView
                android:id="@+id/staffNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/welcome_staff_note"
                android:textAppearance="@style/TextAppearance.CampusFind.Small" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
