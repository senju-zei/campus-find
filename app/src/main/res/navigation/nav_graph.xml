<?xml version="1.0" encoding="utf-8"?>
<!-- Single-activity graph. Step 6 adds Claim, My activity and Staff dashboard. -->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/startFragment">

    <!-- Log out from anywhere: clear the whole stack so Back cannot return to signed-in screens. -->
    <action
        android:id="@+id/action_global_welcome"
        app:destination="@id/welcomeFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/startFragment"
        android:name="ph.edu.bulsu.campusfind.ui.start.StartFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_start">
        <action
            android:id="@+id/action_start_to_welcome"
            app:destination="@id/welcomeFragment"
            app:popUpTo="@id/startFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_start_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/startFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_start_to_feed"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/startFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/welcomeFragment"
        android:name="ph.edu.bulsu.campusfind.ui.welcome.WelcomeFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_login"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_welcome_to_register"
            app:destination="@id/registerFragment" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="ph.edu.bulsu.campusfind.ui.auth.LoginFragment"
        android:label="@string/title_login"
        tools:layout="@layout/fragment_login">
        <argument
            android:name="message"
            android:defaultValue="@null"
            app:argType="ph.edu.bulsu.campusfind.ui.common.UiMessage"
            app:nullable="true" />
        <action
            android:id="@+id/action_login_to_register"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_login_to_feed"
            app:destination="@id/feedFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="ph.edu.bulsu.campusfind.ui.auth.RegisterFragment"
        android:label="@string/title_register"
        tools:layout="@layout/fragment_register">
        <!-- After sign-up, show Login (with the verification notice) on top of Welcome. -->
        <action
            android:id="@+id/action_register_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/welcomeFragment" />
        <action
            android:id="@+id/action_register_to_login_only"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/feedFragment"
        android:name="ph.edu.bulsu.campusfind.ui.feed.FeedFragment"
        android:label="@string/title_feed"
        tools:layout="@layout/fragment_feed">
        <action
            android:id="@+id/action_feed_to_post"
            app:destination="@id/postItemFragment" />
        <action
            android:id="@+id/action_feed_to_detail"
            app:destination="@id/itemDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/postItemFragment"
        android:name="ph.edu.bulsu.campusfind.ui.post.PostItemFragment"
        android:label="@string/title_post_item"
        tools:layout="@layout/fragment_post_item">
        <argument
            android:name="type"
            android:defaultValue="FOUND"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/itemDetailFragment"
        android:name="ph.edu.bulsu.campusfind.ui.detail.ItemDetailFragment"
        android:label="@string/title_item_detail"
        tools:layout="@layout/fragment_item_detail">
        <argument
            android:name="itemId"
            app:argType="string" />
    </fragment>
</navigation>
